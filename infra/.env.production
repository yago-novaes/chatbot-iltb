# =============================================================================
# .env.production — Template de variáveis de ambiente para a VPS (Fase 4)
# =============================================================================
# ATENÇÃO: nunca commitar este arquivo com chaves reais.
# O setup-vps.sh copia este template para /opt/iltb-chatbot/.env na VPS.
# Após copiar, preencher os valores com: nano /opt/iltb-chatbot/.env
# =============================================================================

# --- LLM (Groq free tier) ---
LLM_PROVIDER=groq
LLM_API_KEY=gsk_SUBSTITUIR_PELA_CHAVE_GROQ
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- RAG ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=iltb_protocols
DOCS_PATH=./docs/protocolos
CHUNK_SIZE=800
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.40

# --- WhatsApp Business API ---
# Obter em: https://developers.facebook.com/apps/<APP_ID>/whatsapp-business/wa-dev-console/
WHATSAPP_VERIFY_TOKEN=SUBSTITUIR_TOKEN_VERIFICACAO_WEBHOOK
WHATSAPP_ACCESS_TOKEN=SUBSTITUIR_ACCESS_TOKEN_META
WHATSAPP_PHONE_NUMBER_ID=SUBSTITUIR_PHONE_NUMBER_ID

# --- API ---
API_TITLE=Chatbot ILTB
API_VERSION=0.2.0
LOG_LEVEL=INFO

# --- Session ---
SESSION_MAX_MESSAGES=10
SESSION_TTL_MINUTES=30

# --- RAGAS evaluator (só usado em eval/, não em produção) ---
# Deixar vazio na VPS — avaliação roda apenas em dev local
RAGAS_LLM_PROVIDER=
RAGAS_LLM_API_KEY=
RAGAS_LLM_MODEL=
RAGAS_LLM_BASE_URL=
